{
  "name": "apk-evaluator-dataset-cleaner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify": "vite-node scripts/verify.ts",
    "verify:native": "node scripts/check-native.mjs",
    "verify:all": "npm run verify:native && npm run typecheck && npm run verify && npm run verify:ui && npm run verify:layout",
    "verify:ui": "vite-node scripts/ui-check.ts",
    "verify:layout": "vite-node scripts/layout-check.ts",
    "screenshot": "vite-node scripts/screenshot.ts",
    "cap:sync": "cap sync android",
    "cap:add": "cap add android",
    "android:apk": "cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@playwright/test": "^1.64.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.64.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-node": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
